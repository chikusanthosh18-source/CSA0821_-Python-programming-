

import time

# Original Program - Recursive
calls = 0

def ways_naive(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


# Redesigned Program - Iterative
def ways_redesigned(n):
    if n < 0:
        raise ValueError("Steps cannot be negative")

    if n <= 1:
        return 1

    previous = 1
    current = 1

    for _ in range(2, n + 1):
        previous, current = current, previous + current

    return current


# Compare Original and Redesigned
print("Q7 - DESIGN CHALLENGE")
print("----------------------------")

for n in range(1, 7):
    print("Steps:", n,
          "Original:", ways_naive(n),
          "Redesigned:", ways_redesigned(n))


# Function call comparison
calls = 0
result = ways_naive(25)

print("\nOriginal Result:", result)
print("Original Function Calls:", calls)

print("Redesigned Result:", ways_redesigned(25))
print("Redesigned Loop Iterations:", 24)


# Performance Testing
def measure(func, n):
    start = time.perf_counter()
    result = func(n)
    end = time.perf_counter()
    return result, end - start


print("\nPERFORMANCE COMPARISON")

for n in (10, 20, 25, 30):
    old_result, old_time = measure(ways_naive, n)
    new_result, new_time = measure(ways_redesigned, n)

    print("\nInput:", n)
    print("Original Time:", old_time)
    print("Redesigned Time:", new_time)
    print("Results Match:", old_result == new_result)


# Large Input Validation
print("\nLarge Input Test")
print("n = 1000")
print("Number of digits:",
      len(str(ways_redesigned(1000))))

print("\nProgram Completed Successfully")
